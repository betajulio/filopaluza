rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/approved_emails/$(emailKey()));
    }

    function isOwnApprovedEmailDoc(emailId) {
      return signedIn() && emailId == emailKey();
    }

    match /approved_emails/{emailId} {
      allow get: if isOwnApprovedEmailDoc(emailId) || isMember();
      allow list: if isMember();
      allow create, update, delete: if false;
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isMember();
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isMember();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isMember();

      match /votes/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create, update, delete: if isMember() && request.auth.uid == userId;
      }
    }

    match /repertorio/{docId} {
      allow read: if true;
      allow create, update, delete: if isMember();
    }

    match /logs/{logId} {
      allow read, create, delete: if isMember();
      allow update: if false;
    }

    match /promotion_state/{docId} {
      allow read: if true;
      allow create, update, delete: if isMember();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
